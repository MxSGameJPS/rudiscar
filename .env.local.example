# ===============================================
# Rudi's Car - Variaveis de ambiente (Supabase)
# Copie este arquivo para ".env.local" e preencha
# ===============================================

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica anonima (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Nome do bucket de Storage para imagens dos veiculos
NEXT_PUBLIC_SUPABASE_BUCKET=veiculos
